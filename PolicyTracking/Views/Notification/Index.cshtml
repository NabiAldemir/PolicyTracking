		margin: auto;
		width: 90%;
	}

	th, td {
		text-align: center;
		padding: 10px;
	}

	.modal-title {
		text-align: center;
		width: 100%;
	}
	.custom-calendar{
		max-width : 1350px;
		height:900px;
		margin : 0 auto;
	}
</style>
<h1>Bitiş Tarihi Yaklaşan Poliçeler</h1>
