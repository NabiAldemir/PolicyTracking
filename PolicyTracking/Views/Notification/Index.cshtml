		  document.addEventListener('DOMContentLoaded', function() {
		  var calendarEl = document.getElementById('calendar');
		  var calendar = new FullCalendar.Calendar(calendarEl, {
			initialView: 'dayGridMonth',
			locale:'tr',
			firstDay: 1,
			  headerToolbar: {
		  left: 'prev,next today',
		  center: 'title',
		  right : '',
		},
			   buttonText: {
		  today: 'Bugün',
		},
		events:'/Notification/GetCalendarNotifications',
		eventClick: function(info) {

			const { policyType, customer, daysLeft,policyNumber } = info.event.extendedProps;
			const title = info.event.title;
			const date = info.event.start;
			const formattedDate = date.toLocaleDateString('tr-TR');

			const html = `
							<div class="table-responsive">
				  <table class="table table-bordered table-striped" id="notificatonTable">
					  <thead class="table-dark">
						  <tr>
							  <th style="text-align:center">Poliçe Numarası</th>
							  <th style="text-align:center">Poliçe Türü</th>
							  <th style="text-align:center">Müşteri</th>
							  <th style="text-align:center">Bitiş Tarihi</th>
							  <th style="text-align:center">Kalan Gün Sayısı</th>
							  <th style="text-align:center">Poliçeye Git</th>
						  </tr>
					  </thead>
					  <tbody>
							<tr>
								<td style="text-align:center">${policyNumber}</td>
								<td style="text-align:center">${policyType}</td>
								<td style="text-align:center">${customer}</td>
								<td style="text-align:center">${formattedDate}</td>
								<td style="text-align:center">${daysLeft}</td>
								<td style="text-align:center"><a class="btn btn-primary" onclick ="GoToFilterPolicies(this)" id="goToFilterPolicies" data-policyNumber="${policyNumber}">Poliçeye Git</a></td>
							</tr>
					  </tbody>
				  </table>
			  </div>
			`;

			document.getElementById("modalBodyContent").innerHTML = html;

			// Bootstrap 5 modal açma
			var modal = new bootstrap.Modal(document.getElementById('showNotificationModal'));
			modal.show();
			}
		  });
		  calendar.render();
		});

		function GoToFilterPolicies(button){
			const policyNumber = button.getAttribute("data-policyNumber");
			window.location.href = `/Policy/Index?policyNumber=${encodeURIComponent(policyNumber)}`;
		}

