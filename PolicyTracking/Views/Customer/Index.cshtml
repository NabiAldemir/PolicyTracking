				// İlçeleri getir (belirli bir adres alanı için)
		async function getDistrictsForAddress(index, provinceId) {
			return new Promise(function(resolve, reject) {
				$.getJSON('/Location/GetDistricts?provinceId=' + provinceId, function(data) {
					let options = '<option value="">İlçe Seçiniz</option>';
					$.each(data, function(i, item) {
						options += `<option value="${item.id}">${item.name}</option>`;
					});
					$(`#district${index}`).html(options);
					$(`#neighbourhood${index}`).html('<option value="">Mahalle Seçiniz</option>');
					resolve();
				}).fail(reject);
			});
		}

		// Mahalleleri getir (belirli bir adres alanı için)
		async function getNeighbourhoodsForAddress(index, districtId) {
			return new Promise(function(resolve, reject) {
				$.getJSON('/Location/GetNeighborhoods?districtId=' + districtId, function(data) {
					let options = '<option value="">Mahalle Seçiniz</option>';
					$.each(data, function(i, item) {
						options += `<option value="${item.id}">${item.name}</option>`;
					});
					$(`#neighbourhood${index}`).html(options);
					resolve();
				}).fail(reject);
			});
		}

