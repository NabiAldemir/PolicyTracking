@using PolicyTracking.ViewModels
@model CustomerViewModel
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<title>Müşteriler</title>
<style>
	h1 {
		text-align: center;
		margin-bottom: 20px;
	}

	table {
		margin: auto;
		width: 90%;
	}

	th, td {
		text-align: center;
		padding: 10px;
	}

	.modal-title {
		text-align: center;
		width: 100%;
	}

	.modal-body {
		overflow-y: scroll;
		max-height: 80vh;
	}
</style>
<h1>Müşteriler</h1>
<div class="row mb-3" style="justify-content:center; text-align:center;">
	<div class="col-md-2">
		<label>TC Kimlik No</label>
		<input type="search" class="form-control" placeholder="TC Kimlik No" id="identityNumberFilter" />
	</div>
	<div class="col-md-2">
		<label>Müşteri Türü</label>
		<select id="customerTypeFilter" class="form-control">
			<option value="">Tümü</option>
			<option value="1">Bireysel Müşteri</option>
			<option value="2">Kurumsal Müşteri</option>
		</select>
	</div>
	<div class="col-md-2">
		<label>Müşteri</label>
		<input type="search" class="form-control" placeholder="Müşteri" id="customerFilter" />
	</div>
	<div class="col-md-2">
		<label>Vergİ Numarası</label>
		<input type="search" class="form-control" placeholder="Vergi Numarası" id="taxNumberFilter" />
	</div>
	<div class="col-md-1">
		<button type="button" class="btn btn-warning form-control" onclick="loadFilteredCustomers()" style="margin-top:30px;">Filtrele</button>
	</div>
</div>

<button type="button" class="btn btn-primary mb-2" onclick="openAddModal(this)" style="float:right; width:180px;">Yeni Müşteri Ekle</button>
<div class="table-responsive">
	<table class="table table-bordered table-striped" id="customerTable">
		<thead class="table-dark">
			<tr>
				<th style="text-align:center">TC Kimlik No</th>
				<th style="text-align:center">Müşteri</th>
				<th style="text-align:center">Vergi Numarası</th>
				<th style="text-align:center">Vergi Ofisi</th>
				<th style="text-align:center">Telefon</th>
				<th style="text-align:center">Mail</th>
				<th style="text-align:center">Adres</th>
				<th style="text-align:center">Durum</th>
				<th style="text-align:center">Düzenle</th>
				<th style="text-align:center">Sil</th>
			</tr>
		</thead>
		<tbody>
		</tbody>
	</table>
</div>
<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addModalLabel">Müşteri Ekle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="AddForm">

					<!-- Müşteri Türü Seçimi -->
					<div class="form-group mb-3 text-center">
						<label class="fw-bold">Müşteri Türü:</label><br />
						<div class="form-check form-check-inline">
							<input class="form-check-input" type="radio" id="individualSelect" name="CustomerTypeId" value="1" onchange="radioChange()" />
							<label class="form-check-label" for="individualSelect">Bireysel</label>
						</div>
						<div class="form-check form-check-inline">
							<input class="form-check-input" type="radio" id="institutionalSelect" name="CustomerTypeId" value="2" onchange="radioChange()" />
							<label class="form-check-label" for="institutionalSelect">Kurumsal</label>
						</div>
					</div>
					<div class="form-group text-center">
						<span class="text-danger" data-valmsg-for="CustomerTypeId"></span>
					</div>

					<!-- Bireysel Alanlar -->
					<div id="individualField" style="display:none;">
						<h6 class="fw-bold" style="text-align:center;">Bireysel Müşteri Bilgileri</h6>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label>TC Kimlik No</label>
								<input type="text" class="form-control" name="IdentityNumber" placeholder="TC Kimlik No" />
								<span class="text-danger" data-valmsg-for="IdentityNumber"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Ad</label>
								<input type="text" class="form-control" name="Name" placeholder="Ad" />
								<span class="text-danger" data-valmsg-for="Name"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Soyad</label>
								<input type="text" class="form-control" name="Surname" placeholder="Soyad" />
								<span class="text-danger" data-valmsg-for="Surname"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Doğum Tarihi</label>
								<input type="date" class="form-control" name="DateOfBirth" id="dateOfBirthForAdd" placeholder="Doğum Tarihi" />
								<span class="text-danger" data-valmsg-for="DateOfBirth"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Cinsiyet</label>
								<select type="date" class="form-control" name="Gender" placeholder="Cinsiyet">
									<option>Belirtilmemiş</option>
									<option>Erkek</option>
									<option>Kadın</option>
								</select>
								<span class="text-danger" data-valmsg-for="Gender"></span>
							</div>
						</div>
					</div>

					<!-- Kurumsal Alanlar -->
					<div id="institutionalField" style="display:none;">
						<h6 class="fw-bold" style="text-align:center;">Kurumsal Müşteri Bilgileri</h6>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label>Şirket Adı</label>
								<input type="text" class="form-control" name="CompanyName" placeholder="Şirket Adı" />
								<span class="text-danger" data-valmsg-for="CompanyName"></span>
							</div>
						</div>
					</div>

					<!-- Ortak Alanlar -->
					<div class="mt-4">
						<h6 class="fw-bold" style="text-align:center;">İletişim ve Vergi Bilgileri</h6>
						<div class="row">
							<div class="col-md-6 mb-3">
								<label>Vergi Numarası</label>
								<input type="text" class="form-control" name="TaxNumber" placeholder="Vergi Numarası" />
								<span class="text-danger" data-valmsg-for="TaxNumber"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Vergi Ofisi</label>
								<input type="text" class="form-control" name="TaxOffice" placeholder="Vergi Ofisi" />
								<span class="text-danger" data-valmsg-for="TaxOffice"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Telefon Numarası 1</label>
								<input type="text" class="form-control" name="PhoneNumber1" placeholder="Telefon" />
								<span class="text-danger" data-valmsg-for="PhoneNumber1"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>Telefon Numarası 2</label>
								<input type="text" class="form-control" name="PhoneNumber2" placeholder="Telefon 2" />
								<span class="text-danger" data-valmsg-for="PhoneNumber2"></span>
							</div>
							<div class="col-md-6 mb-3">
								<label>E-Mail</label>
								<input type="text" class="form-control" name="Email" placeholder="Mail Adresi" />
								<span class="text-danger" data-valmsg-for="Email"></span>
							</div>
						</div>
					</div>

					<!-- Adres Alanları -->
					<div id="addressContainerForAdd"></div>
					<button type="button" class="btn btn-success" onclick="addNewAddressField()">Yeni Adres Ekle</button>
					<br />
					<br />
					<br />
					<!-- Butonlar -->
					<div class="text-end">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
						<button type="submit" class="btn btn-primary">Kaydet</button>
					</div>

				</form>
			</div>
		</div>
	</div>
</div>


<!-- Address Detail Modal -->
<div class="modal fade" id="addressDetailModal" tabindex="-1" aria-labelledby="addressDetailLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addressDetailLabel">Adres Bilgileri</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="row">
					<div class="col md-12">
						<ul id="addressInfoList">
						</ul>
					</div>
				</div>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal -->
<div class="modal fade" id="customerUpdateModal" tabindex="-1" aria-labelledby="customerUpdateModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="customerUpdateModalLabel">Müşteri Bilgilerini Güncelle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" id="customerUpdateModalBody">
				<!-- Partial View buraya yüklenecek -->
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>
		let table;
			$(document).ready(function() {
			table = $('#customerTable').DataTable({
				dom: `
				<"d-flex justify-content-between"
					<"d-flex align-items-center gap-3"
						<"ps-1 pe-3"l>
						B
					>
					<"ms-5"f>
				>
				<" p-2"rt>
				<"d-flex justify-content-between"
					i
					p
				>`,
				buttons: [
					{
						extend: 'excelHtml5',
						text: 'Excel\'e Aktar',
						titleAttr: 'Excel\'e Aktar',
						className: 'btn btn-success',
						exportOptions: {
							columns: [0, 1, 2, 3, 4, 5]
						}
					},
					{
						extend: 'csvHtml5',
						text: 'CSV\'ye Aktar',
						titleAttr: 'CSV\'ye Aktar',
						className: 'btn btn-primary',
						exportOptions: {
							columns: [0, 1, 2, 3, 4, 5]
						}
					},
					{
						extend: 'print',
						text: 'Yazdır',
						titleAttr: 'Yazdır',
						className: 'btn btn-secondary',
						exportOptions: {
							columns: [0, 1, 2, 3, 4, 5]
						}
					}
				],
				language: {
					url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
				},
				columnDefs:[
					{
						targets : '_all',
						class : 'text-center'
					}
				],

				columns: [
			{ data: 'identityNumber' },
			{ data: 'name' },
			{ data: 'taxNumber' },
			{ data: 'taxOffice' },
			{ data: 'phoneNumber1' },
			{ data: 'email' },
					{
				data: 'id',
				orderable: false,
				searchable: false,
				render: function (data, type, row) {
					return `<button type="button" class="btn btn-warning" onclick="openAddressDetailModal(this)" data-id="${data}">Adres</button>`;
				}
			},

			// 10 - Durum Rozeti
			{
				data: 'status',
				orderable: false,
				searchable: false,
				render: function (data) {
					const badgeClass = data ? "badge-success" : "badge-danger";
					const label = data ? "Aktif" : "Pasif";
					return `<label class="badge ${badgeClass}">${label}</label>`;
				}
			},

			// 11 - Düzenle Butonu
			{
				data: null,
				orderable: false,
				searchable: false,
				render: function (data) {
					const addressesJson = JSON.stringify(data.addresses).replace(/'/g, "&apos;");
					return `
					<button type="button" class="btn btn-info" onclick="openUpdateModal(this)"
						data-id="${data.id}"
						data-idno="${data.identityNumber}"
						data-name="${data.name}"
						data-surname="${data.surname}"
						data-taxno="${data.taxNumber}"
						data-taxoffice="${data.taxOffice}"
						data-phone1="${data.phoneNumber1}"
						data-phone2="${data.phoneNumber2 || ''}"
						data-mail="${data.email}"
						data-companyName = "${data.companyName}"
						data-country = "${data.country || ''}"
						data-city = "${data.city || ''}"
						data-district = "${data.district || ''}"
						data-neighbourhood = "${data.neighbourhood || ''}"
						data-street = "${data.street || ''}"
						data-doorNumber = "${data.doorNumber || ''}"
						data-postalCode = "${data.postalCode || ''}"
						data-customerTypeId = "${data.customerTypeId || ''}"
						data-addresses='${addressesJson}'
						data-customerId='${data.addresses.customerId}'
						data-gender='${data.gender}'
						data-dateOfBirth='${data.dateOfBirth}'
						>
						Düzenle
					</button>`;
				}
			},

			// 12 - Sil Butonu
			{
				data: 'id',
				orderable: false,
				searchable: false,
				render: function (data) {
					return `<button type="button" class="btn btn-danger" onclick="confirmDelete(${data})">Sil</button>`;
				}
			}
		]
			});
		});
			function openAddModal(button)
			{
				flatpickr("#dateOfBirthForAdd",{
					dateFormat : "d-m-Y",
					locale:"tr"
				});
				$("#addModal").modal("show");
			};

			//Update Modal Açılmadan Önce Yapılması Gerekenler
			async function openUpdateModal(button) {
			const id = button.getAttribute("data-id");
			const addressesJson = button.getAttribute("data-addresses");
			const addresses = JSON.parse(addressesJson);
			const CustomerId = button.getAttribute("data-customerId");
			const modal = new bootstrap.Modal(document.getElementById('customerUpdateModal'));

			const modalBody = document.getElementById('customerUpdateModalBody');
			try {

				if (CustomerId == 1){
					$("#individualSelectForUpdate").val().checked = true
				}
				else if (CustomerId == 1){
					$("#institutionalSelectForUpdate").val().checked = true
				}

				modal.show();

				// Veriyi çek ve modal body'e yerleştir
				const response = await fetch(`/Customer/GetCustomerInformation?id=${id}`);

				if (!response.ok) {
					throw new Error("Veri alınamadı");
				}

				const html = await response.text();
				modalBody.innerHTML = html;

			for (let i = 0; i < addresses.length; i++) {
				let city = addresses[i].city;
				let district = addresses[i].district;
				let neighbourhood = addresses[i].neighbourhood;

				fillLocationSelectsForAddress(i, city, district, neighbourhood)
			}

			updateAddressCount = parseInt(document.getElementById("addressCount").value);
			LoadDefaultSelect2(updateAddressCount);

			} catch (error) {
				console.error("Hata:", error);
				modalBody.innerHTML = `
					<div class="alert alert-danger">
						<strong>Hata!</strong> Müşteri bilgileri yüklenirken bir sorun oluştu.
					</div>
				`;
			}
		}





			//Add İçin Ajax
			document.addEventListener("DOMContentLoaded", function() {
				$("#AddForm").submit(function (e) {
					e.preventDefault();
					$('#AddForm').on('change keyup', 'input, select', function () {
					const fieldName = $(this).attr('name');
					$(`span[data-valmsg-for="${fieldName}"]`).text('');
					});
					const $form = $(this);

					$form.find('span[data-valmsg-for]').text('');

					$.ajax({
						type: "POST",
						url: "/Customer/AddCustomer",
						data: $(this).serialize(),
						dataType: "json", // 🟢 JSON formatında beklediğimizi belirtiyoruz
						success: function (response) {
							if (response.success) {
								toastr.success("Müşteri Başarıyla Eklendi!");
								$("#addModal").modal("hide");
								loadFilteredCustomers();
							 } else {
								response.errors.forEach(function (error) {
								$form.find(`span[data-valmsg-for="${error.field}"]`).text(error.message);
								});
							}
						},
						error: function () {
							Swal.fire("Hata!", "İşlem sırasında hata oluştu!", "error");
						}
					});
				});
			});

		// //Update İçin Ajax
		// 	document.addEventListener("DOMContentLoaded", function() {
		// 									$("#customerUpdateModal").submit(function (e) {
		// 									e.preventDefault();
