		function bindLocationEvents(addressCount) {
			// İl değiştiğinde ilçeleri yükle
			$(`#provinceAdd${addressCount}`).change(function() {
				const provinceId = $(this).val();
				const districtSelect = $(`#districtAdd${addressCount}`);
				const neighbourhoodSelect = $(`#neighbourhoodAdd${addressCount}`);

				if (provinceId) {
					$.getJSON('/Location/GetDistricts?provinceId=' + provinceId, function(data) {
						let options = '<option value="">İlçe Seçiniz</option>';
						$.each(data, function(i, item) {
							options += '<option value="' + item.id + '">' + item.name + '</option>';
						});
						districtSelect.html(options);
						neighbourhoodSelect.html('<option value="">Mahalle/Sokak Seçiniz</option>');
					});
				} else {
					districtSelect.html('<option value="">İlçe Seçiniz</option>');
					neighbourhoodSelect.html('<option value="">Mahalle/Sokak Seçiniz</option>');
				}
			});

			// İlçe değiştiğinde mahalleleri yükle
			$(`#districtAdd${addressCount}`).change(function() {
				const districtId = $(this).val();
				const neighbourhoodSelect = $(`#neighbourhoodAdd${addressCount}`);

				if (districtId) {
					$.getJSON('/Location/GetNeighborhoods?districtId=' + districtId, function(data) {
						let options = '<option value="">Mahalle/Sokak Seçiniz</option>';
						$.each(data, function(i, item) {
							options += '<option value="' + item.id + '">' + item.name + '</option>';
						});
						neighbourhoodSelect.html(options);
					});
				} else {
					neighbourhoodSelect.html('<option value="">Mahalle/Sokak Seçiniz</option>');
				}
			});
		}

