			try {
				const response = await $.get('/Location/GetLocationIdToName', {
					city: city,
					district: district,
					neighbourhood: neighbourhood
				});

				dontSetDistricts = true;
				dontSetNeighbourhood = true;

				$(`#city${index}`).val(response.cityId).trigger('change');
				await getDistrictsForAddress(index, response.cityId);
				$(`#district${index}`).val(response.districtId).trigger('change');
				await getNeighbourhoodsForAddress(index, response.districtId);
				$(`#neighbourhood${index}`).val(response.neighbourhoodId).trigger('change');

			} catch (error) {
				console.error("Konumlar yüklenirken hata:", error);
			} finally {
				dontSetDistricts = false;
				dontSetNeighbourhood = false;
			}
		}
	</script>

}

