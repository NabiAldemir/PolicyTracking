		function reindexAddressFields() {
			const addressFields = $('.address-field').toArray(); // Tüm adres alanlarını al

			addressFields.forEach((field, newIndex) => {
				const $field = $(field);

				// ID'yi güncelle
				field.id = `addressFieldForAdd${newIndex}`;

				// Sil butonunun onclick'ini güncelle
				$field.find('button').attr('onclick', `removeAddressField(${newIndex})`);

				// Tüm input/select name'lerini güncelle
				$field.find('[name^="Addresses"]').each(function() {
					const newName = this.name.replace(
						/Addresses\[\d+\]/g,
						`Addresses[${newIndex}]`
					);
					this.name = newName;
				});

				// Select2'leri yeniden başlat (gerekirse)
				$(`#provinceAdd${newIndex}`).select2({
					placeholder: "İl Seçiniz",
					allowClear: true,
					dropdownParent: $('#addModal')
				});

				$(`#districtAdd${newIndex}`).select2({
					placeholder: "İlçe Seçiniz",
					allowClear: true,
					dropdownParent: $('#addModal')
				});

				$(`#neighbourhoodAdd${newIndex}`).select2({
					placeholder: "Mahalle/Sokak Seçiniz",
					allowClear: true,
					dropdownParent: $('#addModal')
				});
			});

			// Adres sayacını güncelle
			addressCount = addressFields.length;
		}

