		//Delete İçin Ajax ve SweetAlert

		function submitForm(event) {
					event.preventDefault();

					var form = event.target;
					var $form = $(form);


					$form.find('span[data-valmsg-for]').text('');

					$.ajax({
						type: "POST",
						url: $form.attr('action'),
						data: $form.serialize(),
						dataType: "json",
						success: function(response) {
							if (response.success) {
								toastr.success(response.message);
								$("#customerUpdateModal").modal("hide");
								loadFilteredCustomers();
							} else {

								if (response.errors) {
									response.errors.forEach(function(error) {
										$(`span[data-valmsg-for="${error.field}"]`).text(error.message);
									});
								} else {
									toastr.error(response.message || "Bir hata oluştu!");
								}
							}
						},
						error: function(xhr) {
							Swal.fire("Hata!", xhr.responseJSON?.message || "İşlem sırasında bir hata oluştu!", "error");
						}
					});
				}


				$(document).on('change keyup', '#customerUpdateForm input, #customerUpdateForm select', function() {
					const fieldName = $(this).attr('name');
					$(`span[data-valmsg-for="${fieldName}"]`).text('');
				});
			function confirmDelete(customerId){
												Swal.fire({
												title: 'Müşteri Silinecek ,Emin misiniz?',
												text: "Bu işlem geri alınamaz!",
												icon: 'warning',
												showCancelButton: true,
												confirmButtonColor: '#d33',
												cancelButtonColor: '#3085d6',
												confirmButtonText: 'Evet, sil!',
												cancelButtonText: 'İptal'
											}).then((result) => {
												if (result.isConfirmed) {
													$.ajax({
													url: "/Customer/DeleteCustomer/" + customerId,
												method: 'POST',
												success: function (response) {
													if (response.success) {
														toastr.success('Silme İşlemi Başarılı!');
														loadFilteredCustomers();

													} else {
														toastr.error(response.errors.join('\n'));
													}
												},
												error: function () {
													toastr.error('Bir Hata Oluştu!');
												}
											});
												}
											});
										}
		$('#updateModal').on('hidden.bs.modal', function () {
			$('#UpdateForm').find('span[data-valmsg-for]').text('');
		});

				$('#addModal').on('hidden.bs.modal', function () {
					$('#AddForm')[0].reset();
			$('#AddForm').find('span[data-valmsg-for]').text('');
		});

					function openAddressDetailModal(button) {
			var customerId = button.getAttribute("data-id");

			$.ajax({
				url: `/Customer/GetAddressInformation?id=${customerId}`,
				type: 'GET',
				dataType: 'json',
				success: function (data) {
					let contentHtml = "";
					contentHtml += `<h5>Müşteri: ${data.customerName}</h5>
					<div class="row">`;

					if (data && data.addresses && data.addresses.length > 0) {

						data.addresses.forEach(function (address) {
							contentHtml += `
							<div style="display:flex; justify-content:center;">
								${address.title}
							</div>
								<div class="table-responsive mb-3">
									<table class="table table-bordered table-striped">
										<thead class="table-dark">
											<tr>
												<th style= "text-align:center">Ülke</th>
												<th style= "text-align:center">Şehir</th>
												<th style= "text-align:center">İlçe</th>
												<th style= "text-align:center">Mahalle</th>
												<th style= "text-align:center">Cadde</th>
												<th style= "text-align:center">Kapı Numarası</th>
												<th style= "text-align:center">Posta Kodu</th>
											</tr>
										</thead>
											
										<tbody>
											<tr>
												<td>${address.country}</td>
												<td>${address.city}</td>
												<td>${address.district}</td>
												<td>${address.neighbourhood}</td>
												<td>${address.street}</td>
												<td>${address.doorNumber}</td>
												<td>${address.postalCode}</td>
											</tr>
										</tbody>
									</table>
								</div>
							`;
						});
					contentHtml += `</div>`;
					}
					else {
