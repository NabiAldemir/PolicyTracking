			$("#customerTypeFilter").on('change',function() {
			if (!table) return;
			var type = $("#customerTypeFilter").val();

			if (type === "") { // Tümü
				table.columns([0,1,2,3,4,5]).visible(true);
			}
			else if (type === "1") { // Bireysel
				table.columns([0,1,2,3,4,5]).visible(true); // Bireysel kolonlar
			}
			else if (type === "2") { // Kurumsal
				table.columns([0]).visible(false); // Bireysel kolonlar
				table.columns([1,2,3,4,5]).visible(true); // Kurumsal kolonlar
			}

