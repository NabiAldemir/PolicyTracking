@using PolicyTrackingWebUI.ViewModels
 @model AgencyAddressViewModel
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<style>
	h1 {
		text-align: center;
		margin-bottom: 20px;
	}

	table {
		margin: auto;
		width: 90%;
	}

	th, td {
		text-align: center;
		padding: 10px;
	}

	.modal-title {
		text-align: center;
		width: 100%;
	}
</style>
<h1>Acenteler</h1>
<button type="button" class="btn btn-primary mb-2" onclick="openAddModal(this)" style="float:right; width:175px;">Yeni Acente Ekle</button>
<div class="table-responsive">
	<table class="table table-bordered table-striped" id="agencyTable">
		<thead class="table-dark">
			<tr>
				<th style="text-align:center">Acenta Adı</th>
				<th style="text-align:center">Lisans Numarası</th>
				<th style="text-align:center">Mail</th>
				<th style="text-align:center">Telefon</th>
				<th style="text-align:center">Adres</th>
				<th style="text-align:center">Durum</th>
				<th style="text-align:center">Düzenle</th>
				<th style="text-align:center">Sil</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Agencies)
			{
				<tr>
					<td style="text-align:center">@item.Name</td>
					<td style="text-align:center">@item.LicenseNumber</td>
					<td style="text-align:center">@item.Email</td>
					<td style="text-align:center">@item.PhoneNumber</td>
					<td style="text-align:center">
						<button type="button" class="btn btn-warning" onclick="openAddressDetailModal(this)" data-id="@item.Id">Adres</button>
					</td>
					<td>
						<label class="badge @(item.Status ? "badge-success" : "badge-danger")">
							@(item.Status ? "Aktif" : "Pasif")
						</label>
					</td>
					<td>
						<button class="btn btn-info" type="button" onclick="openUpdateModal(this)" data-id="@item.Id" data-name="@item.Name" data-licenseno="@item.LicenseNumber" 
						data-mail="@item.Email" data-phone="@item.PhoneNumber" data-address="@item.Address"
						data-country="@item.Address?.Country" data-city="@item.Address?.City" data-district ="@item.Address?.District"
						data-neighbourhood="@item.Address?.Neighbourhood" data-street="@item.Address?.Street"
						data-doorNumber="@item.Address?.DoorNumber" data-postalCode="@item.Address?.PostalCode"
						data-agencyId ="@item.Address?.AgencyId">Düzenle</button>
					</td>
					<td>
						<button type="button" class="btn btn-danger" onclick="confirmDelete(@item.Id)">Sil</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>	

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addModalLabel">Acente Ekle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="AddForm">
					<div class="form-group row">
						<div class="col md-6">
							<label>Acente Adı</label>
							<input type="text" class="form-control" name="Name" placeholder="Acente Adı" />
							<span class="text-danger" data-valmsg-for="Name"></span>
						</div>
						<div class="col md-6">
							<label>Lisans Numarası</label>
							<input type="text" class="form-control" name="LicenseNumber" placeholder="Lisans Numarası" />
							<span class="text-danger" data-valmsg-for="LicenseNumber"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Telefon Numarası</label>
							<input type="text" class="form-control" name="PhoneNumber" placeholder="Telefon Numarası" />
							<span class="text-danger" data-valmsg-for="PhoneNumber"></span>
						</div>
						<div class="col md-6">
							<label>E-Mail</label>
							<input type="text" class="form-control" name="Email" placeholder="Mail Adresi" />
							<span class="text-danger" data-valmsg-for="Email"></span>
						</div>
					</div>
					<div style="text-align:center;">
						<label>Adres Alanları</label>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Ülke</label>
							<input type="text" class="form-control" name="Country" id="countryForAdd" placeholder="Ülke" readonly autocomplete="off" />
							<span class="text-danger" data-valmsg-for="Country"></span>
						</div>
						<div class="col md-6 d-flex flex-column">
							<label>İl</label>
							<select id="provinceAdd" name="City" class="form-control select2">
								<option value="">İl Seçiniz</option>
								@foreach (var province in Model.Cities)
								{
									<option value="@province.Value">@province.Text</option>
								}
							</select>
							<span class="text-danger" data-valmsg-for="City"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6 d-flex flex-column">
							<label>İlçe</label>
							<select id="districtAdd" name="District" class="form-control select2">
								<option value="">İlçe Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="District"></span>
						</div>
						<div class="col md-6 d-flex flex-column">
							<label>Mahalle/Sokak</label>
							<select class="form-control select2" id="neighbourhoodAdd" name="Neighbourhood">
								<option value="">Mahalle/Sokak Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="Neighbourhood"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Cadde</label>
							<input type="text" class="form-control" name="Street" placeholder="Cadde" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="Street"></span>
						</div>
						<div class="col md-6">
							<label>Kapı Numarası</label>
							<input type="text" class="form-control" name="DoorNumber" placeholder="Kapı Numarası" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="DoorNumber"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Posta Kodu</label>
							<input type="text" class="form-control" name="PostalCode" placeholder="Posta Kodu" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="PostalCode"></span>
						</div>
					</div>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
					<button type="submit" class="btn btn-primary">Kaydet</button>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="updateModalLabel">Acente Bilgisi Güncelle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="UpdateForm">
					<div class="form-group row">
						<div class="col md-6">
							<input name="Id" id="id" hidden />
							<input name="AgencyId" id="agencyId" hidden />
							<label>Acenta Adı</label>
							<input type="text" class="form-control" name="Name" id ="name" placeholder="Acenta Adı" />
							<span class="text-danger" data-valmsg-for="Name"></span>
						</div>
						<div class="col md-6">
							<label>Lisans Numarası</label>
							<input type="text" class="form-control" name="LicenseNumber" id="licenseNumber" placeholder="Lisans Numarası" />
							<span class="text-danger" data-valmsg-for="LicenseNumber"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Telefon Numarası</label>
							<input type="text" class="form-control" name="PhoneNumber" id="phoneNumber" placeholder="Telefon Numarası" />
							<span class="text-danger" data-valmsg-for="PhoneNumber"></span>
						</div>
						<div class="col md-6">
							<label>E-Mail</label>
							<input type="text" class="form-control" name="Email" id="eMail" placeholder="Mail Adresi" />
							<span class="text-danger" data-valmsg-for="Email"></span>
						</div>
					</div>
					<div class="form-group row">
						<input name="Id" id="id" hidden />
						<div class="col md-6">
							<label>Ülke</label>
							<input type="text" class="form-control" id="country" name="Country" placeholder="Ülke" readonly autocomplete="off" />
							<span class="text-danger" data-valmsg-for="Country"></span>
						</div>
						<div class="col md-6 d-flex flex-column">
							<label>İl</label>
							<select id="city" name="City" class="form-control select2">
								<option value="">İl Seçiniz</option>
								@foreach (var province in Model.Cities)
								{
									<option value="@province.Value">@province.Text</option>
								}
							</select>
							<span class="text-danger" data-valmsg-for="City"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6 d-flex flex-column">
							<label>İlçe</label>
							<select id="district" name="District" class="form-control select2">
								<option value="">İlçe Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="District"></span>
						</div>
						<div class="col md-6 d-flex flex-column">
							<label>Mahalle/Sokak</label>
							<select id="neighbourhood" name="Neighbourhood" class="form-control select2">
								<option value="">Mahalle Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="Neighbourhood"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Street</label>
							<input type="text" class="form-control" id="street" name="Street" placeholder="Cadde" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="Street"></span>
						</div>
						<div class="col md-6">
							<label>Kapı Numarası</label>
							<input type="text" class="form-control" id="doorNumber" name="DoorNumber" placeholder="Kapı Numarası" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="DoorNumber"></span>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-6">
							<label>Posta Kodu</label>
							<input type="text" class="form-control" id="postalCode" name="PostalCode" placeholder="Posta Kodu" autocomplete="off" />
							<span class="text-danger" data-valmsg-for="PostalCode"></span>
						</div>
					</div>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
					<button type="submit" class="btn btn-primary">Kaydet</button>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Address Detail Modal -->
<div class="modal fade" id="addressDetailModal" tabindex="-1" aria-labelledby="addressDetailLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addressDetailLabel">Adres Bilgileri</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" style="overflow-y:scroll;">
				<div class="row">
					<div class="col md-12">
						<ul id="addressInfoList">
						</ul>
					</div>
				</div>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<script>
		$(document).ready(function() {

			$('#provinceAdd').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#addModal')
			});
			$('#districtAdd').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#addModal')
			});
			$('#neighbourhoodAdd').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#addModal')
			});

			$('#city').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#updateModal')
			});
			$('#district').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#updateModal')
			});
			$('#neighbourhood').select2({
				placeholder: "Seçiniz",
				allowClear: true,
				minimumResultsForSearch: 0,
				dropdownParent: $('#updateModal')
			});

			$('#agencyTable').DataTable({
				dom: 'Bfrtip',
				buttons: [
					{
						extend: 'excelHtml5',
						text: 'Excel\'e Aktar',
						titleAttr: 'Excel\'e Aktar',
						className: 'btn btn-success'
					},
					{
						extend: 'csvHtml5',
						text: 'CSV\'ye Aktar',
						titleAttr: 'CSV\'ye Aktar',
						className: 'btn btn-primary'
					},
					{
						extend: 'print',
						text: 'Yazdır',
						titleAttr: 'Yazdır',
						className: 'btn btn-secondary'
					}
				],
				language: {
					url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
				}
			});
		});
			function openAddModal(button) {
			$("#countryForAdd").val("TÜRKİYE");
			$("#addModal").modal("show");
		};

		// Add İçin Ajax
		document.addEventListener("DOMContentLoaded", function () {
			$("#AddForm").submit(function (e) {
				e.preventDefault();
				$('#AddForm').on('change keyup', 'input, select', function () {
				const fieldName = $(this).attr('name');
				$(`span[data-valmsg-for="${fieldName}"]`).text('');
				});
				const $form = $(this);

				$form.find('span[data-valmsg-for]').text('');

				$.ajax({
					type: "POST",
					url: "/Agency/AddAgency",
					data: $(this).serialize(),
					dataType: "json", // 🟢 JSON formatında beklediğimizi belirtiyoruz
					success: function (response) {
						if (response.success) {
							toastr.success("Acenta Başarıyla Eklendi!");
							$("#addModal").modal("hide");
							$("#agencyTable").load(location.href + " #agencyTable");
						} else {
								response.errors.forEach(function (error) {
								$form.find(`span[data-valmsg-for="${error.field}"]`).text(error.message);
								});
								}
					},
					error: function () {
						Swal.fire("Hata!", "İşlem sırasında hata oluştu!", "error");
					}
				});
			});
		});

		// İnputları Dolu Getirmesi İçin
		function openUpdateModal(button) {
			let id = button.getAttribute("data-id");
			let LicenseNo = button.getAttribute("data-licenseno");
			let Name = button.getAttribute("data-name");
			let Phone = button.getAttribute("data-phone");
			let Mail = button.getAttribute("data-mail");
			let Country = button.getAttribute("data-country");
			let City = button.getAttribute("data-city");
			let District = button.getAttribute("data-district");
			let Neighbourhood = button.getAttribute("data-neighbourhood");
			let Street = button.getAttribute("data-street");
			let DoorNumber = button.getAttribute("data-doorNumber");
			let PostalCode = button.getAttribute("data-postalCode");
			let AgencyId = button.getAttribute("data-agencyId");
			

			document.getElementById("country").value = Country;
			document.getElementById("street").value = Street;
			document.getElementById("doorNumber").value = DoorNumber;
			document.getElementById("postalCode").value = PostalCode;
			document.getElementById("id").value = id;
			document.getElementById("licenseNumber").value = LicenseNo;
			document.getElementById("name").value = Name;
			document.getElementById("phoneNumber").value = Phone;
			document.getElementById("eMail").value = Mail;
			document.getElementById("agencyId").value = AgencyId;

			fillLocationSelects(City, District, Neighbourhood);

			$("#updateModal").modal("show");
		};

		// Update İçin Ajax
		document.addEventListener("DOMContentLoaded", function () {
			$("#UpdateForm").submit(function (e) {
				e.preventDefault();
				$('#UpdateForm').on('change keyup', 'input, select', function () {
				const fieldName = $(this).attr('name');
				$(`span[data-valmsg-for="${fieldName}"]`).text('');
				});
				const $form = $(this);

				$form.find('span[data-valmsg-for]').text('');

				$.ajax({
					type: "POST",
					url: "/Agency/EditAgency",
					data: $(this).serialize(),
					dataType: "json", // 🟢 JSON formatında beklediğimizi belirtiyoruz
					success: function (response) {
						if (response.success) {
							toastr.success("Acente Bilgileri Başarıyla Değiştirildi!");
							$("#updateModal").modal("hide");
							$("#agencyTable").load(location.href + " #agencyTable");
						} else {
								response.errors.forEach(function (error) {
								$form.find(`span[data-valmsg-for="${error.field}"]`).text(error.message);
								});
								}
					},
					error: function () {
						Swal.fire("Hata!", "İşlem sırasında hata oluştu!", "error");
					}
				});
			});
		});

		// Delete İçin Ajax ve SweetAlert
		function confirmDelete(agencyId) {
			Swal.fire({
				title: 'Acente Silinecek ,Emin misiniz?',
				text: "Bu işlem geri alınamaz!",
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#d33',
				cancelButtonColor: '#3085d6',
				confirmButtonText: 'Evet, sil!',
				cancelButtonText: 'İptal'
			}).then((result) => {
				if (result.isConfirmed) {
					$.ajax({
						url: "/Agency/DeleteAgency/" + agencyId,
						method: 'POST',
						success: function (response) {
							if (response.success) {
								toastr.success('Silme İşlemi Başarılı!');
								$("#agencyTable").load(location.href + " #agencyTable");
							} else {
								toastr.error(response.errors.join('\n'));
							}
						},
						error: function () {
							toastr.error('Bir Hata Oluştu!');
						}
					});
				}
			});
		}
		$('#updateModal').on('hidden.bs.modal', function () {
		$('#UpdateForm').find('span[data-valmsg-for]').text('');
		});

		$('#addModal').on('hidden.bs.modal', function () {
		$('#AddForm')[0].reset();
		$('#AddForm').find('span[data-valmsg-for]').text('');
		});


		//Şehir,İl,İlçe için select change --Add Modal
		$("#provinceAdd").change(function () {
			var provinceId = $(this).val();
			$.getJSON('/Location/GetDistricts?provinceId=' + provinceId, function (data) {
				var options = '<option value="">İlçe Seçiniz</option>';
				$.each(data, function (i, item) {
					options += '<option value="' + item.id + '">' + item.name + '</option>';
				});
				$("#districtAdd").html(options);
				$("#neighborhoodAdd").html('<option value="">Mahalle Seçiniz</option>');
			});
		});

		$("#districtAdd").change(function () {
			var districtId = $(this).val();
			$.getJSON('/Location/GetNeighborhoods?districtId=' + districtId, function (data) {
				var options = '<option value="">Mahalle Seçiniz</option>';
				$.each(data, function (i, item) {
					options += '<option value="' + item.id + '">' + item.name + '</option>';
				});
				$("#neighbourhoodAdd").html(options);
			});
		});


		//Şehir,İl,İlçe için select change --Update Modal
		$("#city").change(async function () {
			const provinceId = $(this).val();

			if (!dontSetDistricts) {
				try {
					await getDistricts(provinceId);
				} catch (error) {
					console.error("İlçeler yüklenirken hata:", error);
					}
				}
			});


		function getDistricts(provinceId) {
		return new Promise(function (resolve, reject) {
		$.getJSON('/Location/GetDistricts?provinceId=' + provinceId, function (data) {
			let options = '<option value="">İlçe Seçiniz</option>';
			$.each(data, function (i, item) {
				options += `<option value="${item.id}">${item.name}</option>`;
			});
			$("#district").html(options);
			$("#neighbourhood").html('<option value="">Mahalle Seçiniz</option>');
			resolve(); // işlem bitti
			}).fail(function (jqXHR, textStatus, errorThrown) {
			reject(errorThrown);
			});
			});
		}


		$("#district").change(async function () {
			const districtId = $(this).val();
			if(!dontSetNeighbourhood) await getNeighbourhoods(districtId);
		});

		function getNeighbourhoods(districtId) {
			return new Promise(function (resolve, reject) {
				$.getJSON('/Location/GetNeighborhoods?districtId=' + districtId, function (data) {
					let options = '<option value="">Mahalle Seçiniz</option>';
					$.each(data, function (i, item) {
						options += `<option value="${item.id}">${item.name}</option>`;
					});
					$("#neighbourhood").html(options);
					resolve();
				}).fail(function (jqXHR, textStatus, errorThrown) {
					reject(errorThrown);
				});
			});
		}

		var dontSetDistricts = false;
		var dontSetNeighbourhood = false;
		async function fillLocationSelects(city, district, neighbourhood) {
			try {
				const response = await $.get('/Location/GetLocationIdToName', {
					city: city,
					district: district,
					neighbourhood: neighbourhood
				});


						dontSetDistricts = true;
						dontSetNeighbourhood = true;
				$('#city').val(response.cityId).trigger('change');

				await getDistricts(response.cityId);

				$('#district').val(response.districtId).trigger('change');

				await getNeighbourhoods(response.districtId);

				$('#neighbourhood').val(response.neighbourhoodId).trigger('change');

			} catch (error) {
				console.error("Konumlar yüklenirken hata:", error);
			}
			finally {

						dontSetDistricts = false;
						dontSetNeighbourhood = false;
			}
		}




			function openAddressDetailModal(button) {
			var agencyId = button.getAttribute("data-id");

			$.ajax({
				url: `/Agency/GetAddressInformation?id=${agencyId}`,
				type: 'GET',
				dataType: 'json',
				success: function (data) {
					let contentHtml = "";

					if (data && data.addressValues) {
						contentHtml += `
						<div class="table-responsive">
							<table class="table table-bordered table-striped">
								<thead class="table-dark">
									<tr>
										<th style= "text-align:center">Müşteri</th>
										<th style= "text-align:center">Ülke</th>
										<th style= "text-align:center">Şehir</th>
										<th style= "text-align:center">İlçe</th>
										<th style= "text-align:center">Mahalle</th>
										<th style= "text-align:center">Cadde</th>
										<th style= "text-align:center">Kapı Numarası</th>
										<th style= "text-align:center">Posta Kodu</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>${data.agencyName}</td>
										<td>${data.addressValues.country}</td>
										<td>${data.addressValues.city}</td>
										<td>${data.addressValues.district}</td>
										<td>${data.addressValues.neighbourhood}</td>
										<td>${data.addressValues.street}</td>
										<td>${data.addressValues.doorNumber}</td>
										<td>${data.addressValues.postalCode}</td>
									</tr>
								</tbody>
							</table>
						</div>`;
					} else {
						contentHtml = `<div class="alert alert-warning mr-4">Bu müşteriye ait adres bilgisi bulunmamaktadır.</div>`;
					}

					$('#addressInfoList').html(contentHtml);
					$('#addressDetailModal').modal('show');
				},
				error: function () {
					toastr.error("Adres bilgisi alınırken bir hata oluştu.");
				}
			});
		}


	</script>

}

