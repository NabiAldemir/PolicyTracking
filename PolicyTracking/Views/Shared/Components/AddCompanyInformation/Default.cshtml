         style="opacity: .8; object-fit: contain; width: 33px; height: 33px;">
    <div style="white-space: normal; word-break: break-word; max-width: 210px;">
        <span class="brand-text font-weight-light">@ViewBag.CompanyName</span>
    </div>
</div>

