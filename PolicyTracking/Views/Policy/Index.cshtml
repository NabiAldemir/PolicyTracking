@using Newtonsoft.Json
@using PolicyTracking.ViewModels
@model PolicyViewModel
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/UserLayout.cshtml";
}
<style>
	h1 {
		text-align: center;
		margin-bottom: 20px;
	}

	table {
		margin: auto;
		width: 100%;
	}

	.modal-title {
		text-align: center;
		width: 100%;
	}

</style>


<h1>Poliçeler</h1>
<div class="row mb-3" style="justify-content:center;">
	<div class="col-md-3">
		<div class="accordion h-100" id="accordionExample1">
			<div class="accordion-item">
				<h2 class="accordion-header" id="headingOne">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
							data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
						Konut Alanları
					</button>
				</h2>
				<div id="collapseOne" class="accordion-collapse collapse collapse" aria-labelledby="headingOne"
					 data-bs-parent="#accordionExample">
					<div class="accordion-body">
						<div class="col-md-12">
							<label>İl</label>
							<select id="cityForFilter" name="City" class="form-control d-flex flex-column">
								<option value="">İl Seçiniz</option>
								@foreach (var province in Model.ProvinceList)
								{
									<option value="@province.Value">@province.Text</option>
								}
							</select>
							<span class="text-danger" data-valmsg-for="City"></span>
						</div>
						<div class="col-md-12">
							<label>İlçe</label>
							<select id="districtForFilter" name="District" class="form-control d-flex flex-column">
								<option value="">İlçe Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="District"></span>
						</div>
						<div class="col-md-12">
							<label>Mahalle/Sokak</label>
							<select id="neighbourhoodForFilter" name="Neighbourhood" class="form-control d-flex flex-column">
								<option value="">Mahalle Seçiniz</option>
							</select>
							<span class="text-danger" data-valmsg-for="Neighbourhood"></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="accordion h-100" id="accordionExample2">
			<div class="accordion-item">
				<h2 class="accordion-header" id="headingTwo">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
							data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
						Araç Alanları
					</button>
				</h2>
				<div id="collapseTwo" class="accordion-collapse collapse collapse" aria-labelledby="headingTwo"
					 data-bs-parent="#accordionExample">
					<div class="accordion-body">
						<div class="col md-2">
							<label>Plaka</label>
							<input type="search" class="form-control" id="plateForFilter" placeholder="Plaka" />
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="accordion h-100" id="accordionExample3">
			<div class="accordion-item">
				<h2 class="accordion-header" id="headingThree">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
							data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
						Tarih Alanları
					</button>
				</h2>
				<div id="collapseThree" class="accordion-collapse collapse collapse" aria-labelledby="headingThree"
					 data-bs-parent="#accordionExample">
					<div class="accordion-body">
						<div class="col-md-12 text-center">
							<label class="fw-bold">Başlangıç Tarih Aralığı</label>
							<div class="d-flex align-items-center justify-content-center">
								<input type="date" class="form-control me-2" id="startDateFrom" placeholder="Başlangıç" />
								<span class="mx-1">-</span>
								<input type="date" class="form-control ms-2" id="startDateTo" placeholder="Bitiş" />
							</div>
						</div>
						<div class="col-md-12 text-center">
							<label class="fw-bold">Bitiş Tarih Aralığı</label>
							<div class="d-flex align-items-center justify-content-center">
								<input type="date" class="form-control me-2" id="endDateFrom" placeholder="Başlangıç" />
								<span class="mx-1">-</span>
								<input type="date" class="form-control ms-2" id="endDateTo" placeholder="Bitiş" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-3">
		<div class="accordion h-100" id="accordionExample4">
			<div class="accordion-item">
				<h2 class="accordion-header" id="headingFour">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
							data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
						Diğer Alanlar
					</button>
				</h2>
				<div id="collapseFour" class="accordion-collapse collapse collapse" aria-labelledby="headingFour"
					 data-bs-parent="#accordionExample">
					<div class="accordion-body" style="max-height:200px; overflow-y:scroll;">
						<div class="col md-12">
							<label>Poliçe Numarası</label>
							<input type="search" class="form-control" id="policyNumberForFilter" value="@Model.policyNumber" placeholder="Poliçe Numarası" />
						</div>

						<div class="col-md-12">
							<label>Poliçe Türü</label>
							<select id="policyTypeFilter" class="form-control">
								<option value="">Seçiniz</option>
								@foreach (var type in Model.PolicyTypeList)
								{
									<option value="@type.Value">@type.Text</option>
								}
							</select>
						</div>
						<div class="col-md-12">
							<label>Acente Adı</label>
							<select class="form-control select2" id="agencyFilter" style="width: 100%;">
								<option value="">Seçiniz</option>
								@if (Model.AgnncyList != null)
								{
									foreach (var user in Model.AgnncyList)
									{
										<option value="@user.Value">@user.Text</option>
									}
								}
							</select>
						</div>

						<div class="col-md-12">
							<label>Müşteri</label>
							<select class="form-control select2" id="customerFilter" style="width: 100%;">
								<option value="">Seçiniz</option>
								@if (Model.Customers != null)
								{
									foreach (var user in Model.Customers)
									{
										<option value="@user.Value">@user.Text</option>
									}
								}
							</select>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="col-md-2" style="margin-top:30px;">
		<button id="filterBtn" class="btn btn-warning" onclick="loadFilteredPolicies()">Filtrele</button>
	</div>
</div>

<button type="button" class="btn btn-primary mb-2" onclick="openAddModal(this)" style="float:right;width:176px;">Yeni Poliçe Ekle</button>
<div class="table-responsive">
	<table class="table table-bordered table-striped" id="policyTable">
		<thead class="table-dark">
			<tr>
				<th style="text-align:center">Acente Adı</th>
				<th style="text-align:center">Poliçe No</th>
				<th style="text-align:center">Poliçe Türü</th>
				<th style="text-align:center">Başlangıç Tarihi</th>
				<th style="text-align:center;width:180px;">Bitiş Tarihi</th>
				<th style="text-align:center">Net Prim</th>
				<th style="text-align:center">Brüt Prim</th>
				<th style="text-align:center">Komisyon</th>
				<th style="text-align:center">Müşteri</th>
				<th style="text-align:center">Bilgi</th>
				<th style="text-align:center">Düzenle</th>
				<th style="text-align:center">Sil</th>
			</tr>
		</thead>
		<tbody>
			<!-- JavaScript ile dolduruluyor -->
		</tbody>
	</table>
</div>

<!-- Add Modal -->
<partial name="./Partials/AddModal" model="@Model" />

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel">
	<div class="modal-dialog modal-lg">
		<!-- Daha geniş modal -->
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addModalLabel">Poliçe Düzenle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="UpdateForm">
					<div class="form-group text-center">
						<label>Poliçe Türü:</label><br />
						@foreach (var item in Model.PolicyTypeList)
						{
							<input type="radio" id="update_@item.Value" name="selectType" value="@item.Value" onchange="toggleField()" required onclick="return false;" />
							<label for="update@item.Text">@item.Text</label>
						}
					</div>

					<div class="form-group row">
						<div class="col-md-3">
							<input hidden id="id" name="Id" />
							<label>Acente Adı</label>
							<select class="form-control select2" id="updateAgencyId" name="AgencyId" style="width: 100%;">
								<option value="">Seçiniz</option>
								@if (Model.AgnncyList != null)
								{
									foreach (var user in Model.AgnncyList)
									{
										<option value="@user.Value">@user.Text</option>
									}
								}
							</select>
							<span class="text-danger" data-valmsg-for="AgencyId"></span>
						</div>
						<div class="col-md-3">
							<label>Poliçe Numarası</label>
							<input type="text" class="form-control" name="PolicyNumber" id="policyNumber" placeholder="Poliçe Numarası" />
							<span class="text-danger" data-valmsg-for="PolicyNumber"></span>
						</div>
						<div class="col-md-3">
							<label>Başlangıç Tarihi</label>
							<input type="date" class="form-control" id="StartDate" name="StartDate" placeholder="Başlangıç Tarihi" />
							<span class="text-danger" data-valmsg-for="StartDate"></span>
						</div>
						<div class="col-md-3">
							<label>Bitiş Tarihi</label>
							<input type="date" class="form-control" id="EndDate" name="EndDate" placeholder="Bitiş Tarihi" />
							<span class="text-danger" data-valmsg-for="EndDate"></span>
						</div>
					</div>

					<div class="form-group row">
						<div class="col-md-4">
							<label>Net Prim</label>
							<input type="number" class="form-control" name="NetPremium" id="netPremium" placeholder="Net Prim" />
							<span class="text-danger" data-valmsg-for="NetPremium"></span>
						</div>
						<div class="col-md-4">
							<label>Brüt Prim</label>
							<input type="number" class="form-control" name="GrossPremium" id="grossPremium" placeholder="Brüt Prim" />
							<span class="text-danger" data-valmsg-for="GrossPremium"></span>
						</div>
						<div class="col-md-4">
							<label>Komisyon</label>
							<input type="number" class="form-control" name="Commission" id="commission" placeholder="Komisyon" />
							<span class="text-danger" data-valmsg-for="Commission"></span>
						</div>
						<div class="form-group row">
							<div class="col-md-6">
								<label>Müşteri</label>
								<select class="form-control select2" id="updateCustomerId" name="CustomerId" style="width: 100%;">
									<option value="">Seçiniz</option>
									@if (Model.Customers != null)
									{
										foreach (var user in Model.Customers)
										{
											<option value="@user.Value">@user.Text</option>
										}
									}
								</select>
								<span class="text-danger" data-valmsg-for="CustomerId"></span>
							</div>
						</div>
					</div>

					<!-- ARAÇ ALANLARI -->
					<div id="vehicleField" style="display:none;">
						<hr />
						<h5 style="text-align:center;">Araç Bilgileri</h5>
						<div class="form-group row">
							<input id="vehicleid" name="VehicleId" hidden />
							<div class="col-md-4">
								<label>Plaka</label>
								<input type="text" class="form-control" name="Plate" id="plate" placeholder="Plaka" />
								<span class="text-danger" data-valmsg-for="Plate"></span>
							</div>
							<div class="col-md-4">
								<label>Marka</label>
								<input type="text" class="form-control" name="Brand" id="brand" placeholder="Marka" />
								<span class="text-danger" data-valmsg-for="Brand"></span>
							</div>
							<div class="col-md-4">
								<label>Model</label>
								<input type="text" class="form-control" name="Model" id="model" placeholder="Model" />
								<span class="text-danger" data-valmsg-for="Model"></span>
							</div>
						</div>
						<div class="form-group row">
							<div class="col-md-4">
								<label>Yıl</label>
								<input type="number" class="form-control" name="ProductionYear" id="productionYear" placeholder="Üretim Yılı" />
								<span class="text-danger" data-valmsg-for="ProductionYear"></span>
							</div>
							<div class="col-md-4">
								<label>Belge Seri No</label>
								<input type="text" class="form-control" name="DocSerialNumber" id="docSerialNumber" placeholder="Belge Seri Numarası" />
								<span class="text-danger" data-valmsg-for="DocSerialNumber"></span>
							</div>
						</div>
					</div>
					<!-- KONUT ALANLARI -->
					<div id="housingField" style="display:none;">
						<hr />
						<h5 style="text-align:center;">Konut Bilgileri</h5>
						<div class="form-group row">
							<div class="col-md-4">
								<label>Ülke</label>
								<input type="text" class="form-control" name="Country" id="country" placeholder="Ülke" readonly />
								<span class="text-danger" data-valmsg-for="Country"></span>
							</div>
							<div class="col-md-4">
								<label>İl</label>
								<select id="city" name="City" class="form-control select2">
									<option value="">İl Seçiniz</option>
									@foreach (var province in Model.ProvinceList)
									{
										<option value="@province.Value">@province.Text</option>
									}
								</select>
								<span class="text-danger" data-valmsg-for="City"></span>
							</div>
							<div class="col-md-4">
								<label>İlçe</label>
								<select id="district" name="District" class="form-control select2">
									<option value="">İlçe Seçiniz</option>
								</select>
								<span class="text-danger" data-valmsg-for="District"></span>
							</div>
						</div>
						<div class="form-group row">
							<div class="col-md-4">
								<label>Mahalle/Sokak</label>
								<select id="neighbourhood" name="Neighbourhood" class="form-control select2">
									<option value="">Mahalle Seçiniz</option>
								</select>
								<span class="text-danger" data-valmsg-for="Neighbourhood"></span>
							</div>
							<div class="col-md-4">
								<label>Cadde</label>
								<input type="text" class="form-control" name="Street" id="street" placeholder="Cadde" />
								<span class="text-danger" data-valmsg-for="Street"></span>
							</div>
							<div class="col-md-4">
								<label>Kapı Numarası</label>
								<input type="text" class="form-control" name="DoorNumber" id="doorNumber" placeholder="Kapı Numarası" />
								<span class="text-danger" data-valmsg-for="DoorNumber"></span>
							</div>
						</div>
						<div class="form-group row">
							<div class="col-md-4">
								<label>Posta Kodu</label>
								<input type="text" class="form-control" name="PostalCode" id="postalCode" placeholder="Posta Kodu" />
								<span class="text-danger" data-valmsg-for="PostalCode"></span>
							</div>
							<div class="col-md-4">
								<label>Yapım Yılı</label>
								<input type="text" class="form-control" name="ConstructionYear" id="constructionYear" placeholder="Yapım Yılı" />
								<span class="text-danger" data-valmsg-for="ConstructionYear"></span>
							</div>
							<div class="col-md-4">
								<label>Toplam Alan (m²)</label>
								<input type="text" class="form-control" name="TotalArea" id="totalArea" placeholder="Alan (m²)" />
								<span class="text-danger" data-valmsg-for="TotalArea"></span>
							</div>
						</div>
						<div class="form-group row">
							<div class="col-md-4">
								<label>Bina Teminat</label>
								<input type="text" class="form-control" name="BuildingCoverageAmount" id="buildingCoverageAmount" placeholder="Bina Teminat" />
								<span class="text-danger" data-valmsg-for="BuildingCoverageAmount "></span>
							</div>
							<div class="col-md-4">
								<label>Eşya Teminat</label>
								<input type="text" class="form-control" name="FurnitureCoverageAmount" id = "furnitureCoverageAmount" placeholder="Eşya Teminat" />
								<span class="text-danger" data-valmsg-for="FurnitureCoverageAmount  "></span>
							</div>
						</div>
					</div>
					<div class="form-group row">
						<div class="col md-12">
							<label>Açıklama</label>
							<textarea class="form-control" name="Description" placeholder="Açıklama" id="description"></textarea>
						</div>
					</div>

					<div class="text-end mt-3">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
						<button type="submit" class="btn btn-primary">Kaydet</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

<!-- Information Modalı -->
<div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="infoModalLabel">Poliçe Bilgileri</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
			</div>
			<div class="modal-body">
				<div class="row">
					<div class="col-md-12">
						<div style="display:flex; justify-content:center;">
							<h5>Poliçe Bilgileri</h5>
						</div>
						<ul id="policyInfoList" class="mb-4 w-100">
						</ul>
					</div>
					<div class="col-md-12">
						<h5 id="vehicleOrHousingTitle" class="mt-4"></h5>
						<ul id="additionalInfo" class="w-100">
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<div class="modal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Modal title</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>Modal body text goes here.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary">Save changes</button>
			</div>
		</div>
	</div>
</div>


@section Scripts {

	<script>
						let policyTable;

				$(document).ready(function () {

					$('#cityForFilter').select2({
						placeholder: "Seçiniz",
						allowClear: true,
						minimumResultsForSearch: 0,
						dropdownParent: $('#accordionExample1'),
						width: '100%'
					});


					$('#districtForFilter').select2({
						placeholder: "Seçiniz",
						allowClear: true,
						minimumResultsForSearch: 0,
						dropdownParent: $('#accordionExample1'),
						width: '100%'
					});


					$('#neighbourhoodForFilter').select2({
						placeholder: "Seçiniz",
						allowClear: true,
						minimumResultsForSearch: 0,
						dropdownParent: $('#accordionExample1'),
						width: '100%'
					});
					policyTable = $('#policyTable').DataTable({
						dom: 'Bfrtip',
						buttons: [
							{
								extend: 'excelHtml5',
								text: 'Excel\'e Aktar',
								className: 'btn btn-success'
							},
							{
								extend: 'csvHtml5',
								text: 'CSV\'ye Aktar',
								className: 'btn btn-primary'
							},
							{
								extend: 'print',
								text: 'Yazdır',
								className: 'btn btn-secondary'
							}
						],
						language: {
							url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
						},
						columnDefs:[
							{targets: 3,width:"12%"},
							{targets: 4,width:"12%"},
							{
								targets : '_all',
								class : 'text-center'
							}
						],
							columns: [
							{data : 'agencyName'},
							{data : 'policyNumber'},
							{data : 'policyTypeName'},
							{data : 'startDate'},
							{data : 'endDate'},
							{
								data:'netPremium',
								render : function(data){
										return data + " "+ '₺'}
							},
							{
								data:'grossPremium',
								render : function(data){
										return data + " "+ '₺'}
							},
							{
								data:'commission',
								render : function(data){
										return data + " "+ '₺'}
							},
							{data : 'customerName'},
							{
								data: null,
								render: function (data) {
									return `
									<button type="button" class="btn btn-primary rounded-circle" style="width: 40px; height: 40px; padding: 6px;"
										onclick="openInfoModal(this)"
										data-id="${data.id}"
										data-agencyname="${data.agencyName}"
										data-policynumber="${data.policyNumber}"
										data-policytypename="${data.policyTypeName}"
										data-startdate="${data.startDate}"
										data-enddate="${data.endDate}"
										data-netPremium="${data.netPremium}"
										data-grossPremium="${data.grossPremium}"
										data-commission="${data.commission}"
										data-customername="${data.customerName}"
										data-plate="${data.plate || ''}"
										data-brand="${data.brand || ''}"
										data-model="${data.model || ''}"
										data-productionyear="${data.productionYear || ''}"
										data-color="${data.color || ''}"
										data-mileage="${data.mileage || ''}"
										data-district="${data.district || ''}"
										data-neighbourhood="${data.neighbourhood || ''}"
										data-city="${data.city || ''}"
